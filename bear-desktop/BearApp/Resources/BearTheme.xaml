<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BEAR Color Palette -->
    <Color x:Key="BearPrimaryColor">#FF6A00</Color>
    <Color x:Key="BearSecondaryColor">#FFFFFF</Color>
    <Color x:Key="BearBackgroundColor">#111111</Color>
    <Color x:Key="BearBgLightColor">#1A1A1A</Color>
    <Color x:Key="BearBgLighterColor">#222222</Color>
    <Color x:Key="BearBgCardColor">#1E1E1E</Color>
    <Color x:Key="BearAccentColor">#FF8533</Color>
    <Color x:Key="BearBorderColor">#333333</Color>
    <Color x:Key="BearMutedColor">#888888</Color>
    <Color x:Key="BearSuccessColor">#22C55E</Color>
    <Color x:Key="BearWarningColor">#EAB308</Color>
    <Color x:Key="BearDangerColor">#EF4444</Color>
    <Color x:Key="BearInfoColor">#3B82F6</Color>

    <SolidColorBrush x:Key="BearPrimary" Color="{StaticResource BearPrimaryColor}"/>
    <SolidColorBrush x:Key="BearSecondary" Color="{StaticResource BearSecondaryColor}"/>
    <SolidColorBrush x:Key="BearBackground" Color="{StaticResource BearBackgroundColor}"/>
    <SolidColorBrush x:Key="BearBgLight" Color="{StaticResource BearBgLightColor}"/>
    <SolidColorBrush x:Key="BearBgLighter" Color="{StaticResource BearBgLighterColor}"/>
    <SolidColorBrush x:Key="BearBgCard" Color="{StaticResource BearBgCardColor}"/>
    <SolidColorBrush x:Key="BearAccent" Color="{StaticResource BearAccentColor}"/>
    <SolidColorBrush x:Key="BearBorder" Color="{StaticResource BearBorderColor}"/>
    <SolidColorBrush x:Key="BearMuted" Color="{StaticResource BearMutedColor}"/>
    <SolidColorBrush x:Key="BearSuccess" Color="{StaticResource BearSuccessColor}"/>
    <SolidColorBrush x:Key="BearWarning" Color="{StaticResource BearWarningColor}"/>
    <SolidColorBrush x:Key="BearDanger" Color="{StaticResource BearDangerColor}"/>
    <SolidColorBrush x:Key="BearInfo" Color="{StaticResource BearInfoColor}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="BearGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A00" Offset="0"/>
        <GradientStop Color="#FF8533" Offset="0.5"/>
        <GradientStop Color="#FF9955" Offset="1"/>
    </LinearGradientBrush>

    <!-- Button Style -->
    <Style x:Key="BearButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BearPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="12" Padding="{TemplateBinding Padding}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BearAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="BearTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CaretBrush" Value="{StaticResource BearPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="#1AFFFFFF" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BearPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox Style -->
    <Style x:Key="BearPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CaretBrush" Value="{StaticResource BearPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="#1AFFFFFF" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BearPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Style -->
    <Style x:Key="BearCard" TargetType="Border">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Nav Button -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#99FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
