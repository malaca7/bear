<Window x:Class="BearApp.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEAR - Recuperar Senha" Width="480" Height="450"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="{StaticResource BearBackground}" MouseLeftButtonDown="DragWindow">
        <Grid>
            <!-- Close button -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                    Width="32" Height="32" FontSize="14" Click="CloseClick"
                    Background="Transparent" Foreground="#66FFFFFF" BorderThickness="0" Cursor="Hand"/>

            <StackPanel VerticalAlignment="Center" Margin="48">
                <!-- Logo -->
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource BearPrimary}" 
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="B" FontSize="32" FontWeight="Black" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Recuperar Senha" FontSize="24" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Digite o seu e-mail para recuperar a senha" FontSize="13" Foreground="#66FFFFFF" 
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Error message -->
                <Border x:Name="ErrorBorder" Visibility="Collapsed" CornerRadius="12" Padding="16,10"
                        Margin="0,0,0,16" Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1">
                    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Success message -->
                <Border x:Name="SuccessBorder" Visibility="Collapsed" CornerRadius="12" Padding="16,10"
                        Margin="0,0,0,16" Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1">
                    <TextBlock x:Name="SuccessText" Foreground="#22C55E" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Email -->
                <TextBlock Text="E-mail" FontSize="13" Foreground="#99FFFFFF" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource BearTextBox}" Margin="0,0,0,24"/>

                <!-- Submit button -->
                <Button x:Name="SubmitButton" Content="Enviar E-mail de Recuperação" Style="{StaticResource BearButton}" 
                        Click="SubmitClick" Margin="0,0,0,16"/>

                <!-- Back to login link -->
                <TextBlock Text="Voltar para o Login" FontSize="13" Foreground="{StaticResource BearPrimary}" 
                           HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BackToLoginClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
