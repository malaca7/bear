<Window x:Class="BearApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEAR - Login" Width="480" Height="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="{StaticResource BearBackground}" MouseLeftButtonDown="DragWindow">
        <Grid>
            <!-- Close button -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                    Width="32" Height="32" FontSize="14" Click="CloseClick"
                    Background="Transparent" Foreground="#66FFFFFF" BorderThickness="0" Cursor="Hand"/>

            <StackPanel VerticalAlignment="Center" Margin="48">
                <!-- Logo -->
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource BearPrimary}" 
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="B" FontSize="32" FontWeight="Black" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Bem-vindo de volta" FontSize="24" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Entre com suas credenciais" FontSize="13" Foreground="#66FFFFFF" 
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Error message -->
                <Border x:Name="ErrorBorder" Visibility="Collapsed" CornerRadius="12" Padding="16,10"
                        Margin="0,0,0,16" Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1">
                    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Email -->
                <TextBlock Text="E-mail" FontSize="13" Foreground="#99FFFFFF" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource BearTextBox}" Margin="0,0,0,16"/>

                <!-- Password -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Senha" FontSize="13" Foreground="#99FFFFFF"/>
                    <TextBlock Text="Esqueceu?" FontSize="12" Foreground="{StaticResource BearPrimary}" 
                               HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="ForgotPasswordClick"/>
                </Grid>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource BearPasswordBox}" Margin="0,0,0,24"/>

                <!-- Login button -->
                <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource BearButton}" 
                        Click="LoginClick" Margin="0,0,0,16"/>

                <!-- Register link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Não tem conta? " FontSize="13" Foreground="#66FFFFFF"/>
                    <TextBlock Text="Criar conta" FontSize="13" Foreground="{StaticResource BearPrimary}" 
                               Cursor="Hand" MouseLeftButtonDown="RegisterClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
