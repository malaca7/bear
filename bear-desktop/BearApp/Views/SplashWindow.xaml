<Window x:Class="BearApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEAR" Width="500" Height="350"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="{StaticResource BearBackground}">
        <Grid>
            <!-- Bear pattern background -->
            <Border Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF6A00">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Border Width="80" Height="80" CornerRadius="20" Background="{StaticResource BearPrimary}" 
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="B" FontSize="40" FontWeight="Black" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="BEAR" FontSize="36" FontWeight="Black" HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6A00" Offset="0"/>
                            <GradientStop Color="#FF8533" Offset="0.5"/>
                            <GradientStop Color="#FF9955" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="Platform" FontSize="14" Foreground="#66FFFFFF" 
                           HorizontalAlignment="Center" Margin="0,4,0,30"/>

                <!-- Loading indicator -->
                <ProgressBar x:Name="LoadingBar" Width="200" Height="3" IsIndeterminate="True"
                             Background="#1AFFFFFF" Foreground="{StaticResource BearPrimary}"
                             BorderThickness="0"/>

                <TextBlock x:Name="StatusText" Text="Carregando..." FontSize="12" 
                           Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
